{
  "rules": {
    ".read": "auth != null",
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && auth.uid === $uid && (!data.exists() || newData.child('role').val() === data.child('role').val())",
        "uid": { ".validate": "newData.isString() && newData.val() === $uid" },
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
        "email": { ".validate": "newData.isString() && newData.val().length > 0" },
        "targetExam": { ".validate": "newData.isString()" },
        "role": { ".validate": "newData.isString() && (newData.val() === 'student' || newData.val() === data.val())" }
      }
    },
    "revisionaryTests": {
      "$class": {
        "$testId": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
        }
      }
    },
    "results": {
      "$class": {
        "$testId": {
          "$resultId": {
            ".read": "auth != null && (data.child('uid').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
            ".write": "auth != null && newData.child('uid').val() === auth.uid"
          }
        }
      }
    },
    "jobs": {
      ".read": "auth != null",
      "$jobId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "currentAffairs": {
      ".read": "auth != null",
      "$itemId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "study": {
      ".read": "auth != null",
      "$itemId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    }
  }
}