{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "exams": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "courses": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "tests": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "jobs": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "currentAffairs": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "studyResources": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "courseContent": {
      "$courseId": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('courses').child($courseId).child('type').val() === 'free' && root.child('users').child(auth.uid).child('enrollments').child($courseId).val() === true || root.child('courseAccess').child(auth.uid).child($courseId).val() === true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && !data.exists() && newData.child('uid').val() === auth.uid && newData.child('email').val() === auth.token.email))",
        "lastLogin": {
          ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
          ".validate": "newData.isNumber()"
        },
        "enrollments": {
          "$courseId": {
            ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
            ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || auth.uid === $uid && $courseId === 'free-foundation' && newData.val() === true)"
          }
        },
        "enrollmentMeta": {
          "$courseId": {
            ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
            ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || auth.uid === $uid && $courseId === 'free-foundation')"
          }
        },
        "purchases": {
          "$purchaseId": {
            ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
            ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || auth.uid === $uid && !data.exists())"
          }
        },
        "results": {
          "$resultId": {
            ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
            ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || auth.uid === $uid && !data.exists() && newData.child('userId').val() === auth.uid)"
          }
        }
      },
      ".indexOn": [
        "email",
        "targetExam",
        "createdAt"
      ]
    },
    "courseAccess": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "$courseId": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
        }
      }
    },
    "purchases": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$purchaseId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || !data.exists() && newData.child('userId').val() === auth.uid)",
        ".validate": "auth != null && (root.child('admins').child(auth.uid).val() === true || (newData.child('userId').val() === auth.uid && newData.child('courseId').isString() && newData.child('courseId').val().length > 0 && newData.child('amount').isNumber() && newData.child('amount').val() > 0 && newData.child('status').val() === 'pending' && newData.child('transactionId').isString() && newData.child('transactionId').val().length >= 6))"
      },
      ".indexOn": [
        "userId",
        "status",
        "createdAt"
      ]
    },
    "results": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$resultId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || !data.exists() && newData.child('userId').val() === auth.uid)",
        ".validate": "newData.child('userId').val() === auth.uid && newData.child('score').isNumber() && newData.child('total').isNumber()"
      }
    },
    "deletedUsers": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "activity": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "$activityId": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || auth.uid === $uid && !data.exists() && newData.child('userId').val() === auth.uid)",
          ".validate": "newData.hasChildren(['userId','action','createdAt']) && newData.child('userId').val() === auth.uid && newData.child('action').isString() && newData.child('createdAt').isNumber()"
        }
      },
      ".indexOn": [
        "createdAt"
      ]
    }
  }
}